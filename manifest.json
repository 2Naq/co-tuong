{
  "manifest_version": 3,
  "name": "Ziga Cờ Tướng - Mod Quân Đã Ăn",
  "version": "1.0.0",
  "description": "Hiển thị quân đã bị ăn & highlight tầm ăn quân cờ trên Ziga (zigavn.com). Không can thiệp logic game.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://zigavn.com/*"],
      "css": ["overlay.css"],
      "js": ["content_loader.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*", "injected.js", "overlay.css", "icons/*"],
      "matches": ["*://zigavn.com/*"]
    }
  ]
}
